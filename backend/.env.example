# Spring Boot Render Environment Variables
DB_URL=jdbc:postgresql://your-render-postgres-host:5432/gem_forensic
DB_USERNAME=postgres
DB_PASSWORD=your_render_postgres_password
AI_SERVICE_URL=https://your-gem-ai-service.onrender.com
UPLOAD_DIR=/tmp/uploads
JWT_SECRET=your_production_jwt_secret_key_change_me_12345
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Optional API Keys
LLM_API_KEY=your_optional_llm_api_key
GOOGLE_CLIENT_ID=your_optional_google_client_id
GOOGLE_CLIENT_SECRET=your_optional_google_client_secret
